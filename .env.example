# Chave secreta usada somente pelo servidor. Nunca use VITE_ neste nome.
OPENAI_API_KEY=cole_sua_chave_aqui

# Modelo equilibrado entre qualidade e custo para o Agente Light+.
OPENAI_MODEL=gpt-5.6-terra

# Opcional: porta do servidor local.
PORT=5173

# Limites opcionais do Agente Light+ (valores provisórios)
# AGENT_GLOBAL_LIMIT_5MIN=30
# AGENT_GLOBAL_LIMIT_DAY=100
